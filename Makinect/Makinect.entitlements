<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Required when Hardened Runtime is enabled. Without this, AVCaptureDevice
	     auto-denies mic access (notDetermined → denied) without showing the
	     system prompt. NSMicrophoneUsageDescription alone isn't enough. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Same story for the camera, in case any future feature needs it -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
